# Copy to .env for local dev (docker-compose reads these defaults).
ENV=dev
PORT=8080

# Postgres / Redis (docker-compose service hostnames)
DATABASE_URL=postgres://forin:forin@localhost:5432/forin?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Auth — JWT signing (>=16 bytes; generate a strong random value in real envs)
JWT_SIGNING_KEY=dev-only-change-me-please-0123456789
JWT_ISSUER=forin
ACCESS_TTL=15m
REFRESH_TTL=720h

# OIDC client IDs (accepted audiences). Leave empty to disable a provider.
# Comma-separated when a provider has more than one: Google issues a separate
# OAuth client ID per platform (iOS / Android / Web) and the id_token's `aud` is
# whichever client requested it, so list every platform the app ships on. These
# must match the mobile app's EXPO_PUBLIC_GOOGLE_*_CLIENT_ID values.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
KAKAO_CLIENT_ID=

# AI — LLM provider is swappable behind LLMPort.
# LLM_PROVIDER: "anthropic" | "openai" | empty (auto: openai if its key set, else anthropic).
LLM_PROVIDER=

# Anthropic (ANTHROPIC_API_KEY preferred; ANTHROPIC_KEY also accepted). Needs account credits.
ANTHROPIC_API_KEY=
ANTHROPIC_DIALOGUE_MODEL=claude-sonnet-4-6
ANTHROPIC_CORRECTION_MODEL=claude-haiku-4-5-20251001

# OpenAI (OPENAI_API_KEY preferred; OPENAI_KEY also accepted). Paste the FULL key, no quotes/spaces.
OPENAI_API_KEY=
OPENAI_DIALOGUE_MODEL=gpt-4o
OPENAI_CORRECTION_MODEL=gpt-4o-mini

# Azure Speech (pronunciation assessment — Stage 3b)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
