# forin mobile — public runtime config (EXPO_PUBLIC_* is inlined into the JS bundle).
# Copy to .env and fill in. Social login stays disabled until its client ID is set.

# API base (default http://localhost:8080 if unset)
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Google OIDC — from Google Cloud console (OAuth 2.0 client IDs, one per platform).
# iOS = bundle id; Android = package name + signing SHA-1; Web = id_token audience.
# The id_token's `aud` is whichever platform client requested it, so the server's
# GOOGLE_CLIENT_ID must list every ID below (comma-separated).
# App id: bundle id / package name are both  app.forin.mobile
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Kakao OIDC — NATIVE app key from the Kakao developers console (NOT the REST key).
# Kakao's console refuses custom-scheme redirect URIs for a REST key (http/https
# only), but `kakao<NATIVE_APP_KEY>://oauth` is implicitly bound to the native key —
# the same redirect Kakao's own SDKs use — so we drive the OIDC endpoints with the
# native key as client_id. That key must also appear in app.json `scheme` as
# `kakao<key>`, and the server's KAKAO_CLIENT_ID (the id_token audience) equals it.
# Enable OpenID Connect in the console or no id_token is issued.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
