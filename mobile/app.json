{
  "expo": {
    "name": "forin",
    "slug": "forin",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/78c4eab3-2e5c-4bf7-a411-127754f91079",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forin",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "app.forin.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.forin.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFEDD5",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 180
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "발음 연습을 위해 마이크 접근이 필요합니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "아바타 얼굴 스캔에만 카메라를 씁니다. 사진은 기기를 떠나지 않고 저장되지 않아요.",
          "recordAudioAndroid": false
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "08f72ff4761dd9d698d54e82723c0258",
          "ios": {
            "handleKakaoOpenUrl": true
          },
          "android": {
            "authCodeHandlerActivity": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      [
        "./plugins/withKakaoSdkVersion",
        {
          "version": "2.22.5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78c4eab3-2e5c-4bf7-a411-127754f91079"
      }
    }
  }
}
